APP_PORT=8080
# Optional local browser-backed Xiaohongshu/Tieba reader; no Bilibili/Douyin.
# Paths must point to an installed MediaCrawler checkout and its Python runtime.
MEDIACRAWLER_HOME=
MEDIACRAWLER_PYTHON=
MEDIACRAWLER_BRIDGE=
MEDIACRAWLER_CDP=ws://127.0.0.1:9222/devtools/browser
MYSQL_DSN=cs_pulse:YOUR_PASSWORD@tcp(127.0.0.1:3306)/cs_pulse?charset=utf8mb4&parseTime=True&loc=Local
MYSQL_PASSWORD=YOUR_PASSWORD
CORS_ORIGIN=http://localhost:5173
# 请填可识别且带联系方式的 User-Agent。
COLLECTOR_USER_AGENT=CSPulseLearning/0.1 (contact: your-email@example.com)
ENABLE_HLTV_COLLECTOR=true
# 可选：替换 MyMemory 兼容翻译服务地址。
# TRANSLATION_URL=https://api.mymemory.translated.net/get
